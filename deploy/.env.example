# External PostgreSQL (e.g. AWS RDS)
DB_HOST=your-db.xxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=HRMS

# Quote passwords that contain special characters (* : ~ # etc.)
DB_PASSWORD="your-secure-password"

# MUST be wrapped in double quotes (semicolons break shell sourcing)
DB_CONNECTION_STRING="Host=your-db.xxxxx.ap-south-1.rds.amazonaws.com;Port=5432;Database=postgres;Username=HRMS;Password='your-secure-password';SSL Mode=Require;Trust Server Certificate=true"

# Public app URL — no trailing slash (frontend + API on same port)
APP_URL=http://YOUR_SERVER_PUBLIC_IP:8080
APP_PORT=8080
